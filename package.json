{
  "name": "@docupipe/mcp",
  "version": "0.1.0",
  "description": "DocuPipe MCP server: upload documents and extract structured data from Claude Code, Codex, Cursor and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.DocuPipe/docupipe-mcp",
  "bin": {
    "docupipe-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "docupipe",
    "document-extraction",
    "ocr",
    "pdf",
    "claude",
    "codex",
    "cursor"
  ],
  "homepage": "https://www.docupipe.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocuPipe/docupipe-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  },
  "author": "DocuPipe <support@docupipe.ai>"
}
